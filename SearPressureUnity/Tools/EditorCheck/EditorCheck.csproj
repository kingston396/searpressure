<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compile-checks the editor tools against UnityEditor's reference assembly (2021.1). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>CS0162;CS0168;CS0219;CS0414;CS0649;CS0169;CS8321;CS0618</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/SearPressure/Core/**/*.cs" />
    <Compile Include="../../Assets/SearPressure/Unity/**/*.cs" />
    <Compile Include="../../Assets/SearPressure/Editor/**/*.cs" />
  </ItemGroup>
  <!-- Google Mobile Ads DLLs: from Unity's package cache once the project has been opened, or point
       GmaDir at the plugin's GoogleMobileAds folder (e.g. a clone of googleads-mobile-unity). -->
  <PropertyGroup>
    <GmaDir Condition="'$(GmaDir)' == '' And Exists('$(MSBuildThisFileDirectory)../../Library/PackageCache')">$([System.IO.Directory]::GetDirectories('$(MSBuildThisFileDirectory)../../Library/PackageCache', 'com.google.ads.mobile*')[0])/GoogleMobileAds</GmaDir>
  </PropertyGroup>
  <!-- -p:ExtraDefines=UNITY_ANDROID compiles the Android-only code (Play Billing) too. -->
  <PropertyGroup Condition="'$(ExtraDefines)' != ''">
    <DefineConstants>$(DefineConstants);$(ExtraDefines)</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GmaDir)' != ''">
    <DefineConstants>$(DefineConstants);SEARPRESSURE_ADS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(GmaDir)' != ''">
    <Reference Include="GoogleMobileAds"><HintPath>$(GmaDir)/GoogleMobileAds.dll</HintPath></Reference>
    <Reference Include="GoogleMobileAds.Core"><HintPath>$(GmaDir)/GoogleMobileAds.Core.dll</HintPath></Reference>
    <Reference Include="GoogleMobileAds.Common"><HintPath>$(GmaDir)/GoogleMobileAds.Common.dll</HintPath></Reference>
    <Reference Include="GoogleMobileAds.Ump"><HintPath>$(GmaDir)/GoogleMobileAds.Ump.dll</HintPath></Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Unity3D.SDK" Version="2021.1.14.1" />
  </ItemGroup>
</Project>
